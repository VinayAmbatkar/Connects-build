EXPO_PUBLIC_API_URL=https://stagging-backend-tcgym.ondigitalocean.app
# local: EXPO_PUBLIC_API_URL=http://localhost:8080/api
# Android emulator local: EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# Web app origin that hosts /auth/google-success (must match backend redirect)
EXPO_PUBLIC_WEB_ORIGIN=https://www.cobilds.com

# Google Cloud Console OAuth Client IDs (native Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id
